# Copie para .env e preencha. Nunca versione o .env com segredos.
# Autenticacao com o Fabric e feita via az CLI.
# Execute "az login" antes de usar, ou use o botao "az login" no front-end (Configuracao > Microsoft Fabric).

# ---- Perfil ativo ----
DLCTL_PROFILE=ms_client_constellation

# ---- Workspace Fabric alvo ----
FABRIC_WORKSPACE_NAME=LAKEHOUSE-DEV
FABRIC_WORKSPACE_ID=

# ---- az CLI -- opcoes de autenticacao ----
# Tenant ID opcional: passado como --tenant ao az account get-access-token.
# Deixe em branco para usar o tenant padrao da conta az ativa.
FABRIC_AZ_TENANT_ID=

# Escopo de permissao da conta az no workspace Fabric:
#   read_only   -- somente inventario, geracao local, dry-run (padrao seguro)
#   contributor -- permite write/execute/publish via API Fabric
FABRIC_AZ_PERMISSION_SCOPE=read_only

# ---- Oracle Fusion (banco / BI Publisher) ----
ORACLE_DB_DSN=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_BIP_BASE_URL=
ORACLE_BIP_USER=
ORACLE_BIP_PASSWORD=

# ---- Seguranca (gates de escrita) ----
DLCTL_ALLOW_WRITE=false
DLCTL_ALLOW_PRODUCTION=false
