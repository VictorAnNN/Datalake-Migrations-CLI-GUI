# Copie para .env e preencha com valores reais. Nunca versione o .env com segredos.

# ---- Perfil ativo ----
DLCTL_PROFILE=ms_client_constellation

# ---- Microsoft Fabric / Entra ID ----
# Modo padrão recomendado para uso local/CLI: azure_cli. Reaproveita a sessão
# aberta com `az login` (+ `az account set --subscription ...`), sem precisar
# cadastrar App Registration nem client secret.
FABRIC_AUTH_MODE=azure_cli
# azure_cli (padrão) | device_code | client_credentials

# Necessários apenas para device_code/client_credentials (App Registration):
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
# Auth de usuário (device code) não precisa de secret. Para client credentials (serviço), preencha:
FABRIC_CLIENT_SECRET=

# ---- Workspace Fabric alvo ----
FABRIC_WORKSPACE_NAME=LAKEHOUSE-DEV
FABRIC_WORKSPACE_ID=
# Opcional: workspace de Homologação (HML), usado por `dlctl lineage sync-notebooks-hml`
# e pelo comparativo DEV vs HML na página Supervisor.
FABRIC_WORKSPACE_ID_HML=

# ---- Oracle Fusion (banco / BI Publisher) ----
ORACLE_DB_DSN=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_BIP_BASE_URL=
ORACLE_BIP_USER=
ORACLE_BIP_PASSWORD=

# ---- Segurança ----
# Nunca coloque segredos em manifests ou variable libraries. Use Key Vault references.
DLCTL_ALLOW_WRITE=false
DLCTL_ALLOW_PRODUCTION=false
# Downloads simultâneos de notebooks (1 a 8). Comece com 4; reduza se a API retornar 429.
FABRIC_SYNC_MAX_WORKERS=8
